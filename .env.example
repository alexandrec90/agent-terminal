# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so keep every key here with a safe placeholder value.

# ---------------------------------------------------------------------------
# Worktree identity and host ports
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME MUST equal this checkout's directory name. It namespaces
# the stack's containers, network, and volumes, so a worktree running in parallel
# stays fully independent — and `scripts/docker_common.py`-style tooling filters
# `docker ps` by it.
COMPOSE_PROJECT_NAME=agent-terminal

# Every published port is `conventional_base + slot`, where this checkout's slot
# is 9. The registry that assigns slots is devkit's `ports.toml` — add a
# project there rather than picking a free-looking number by hand. Re-generate
# this block with: python <devkit>/scripts/devkit_ports.py agent-terminal

# ---------------------------------------------------------------------------
# The app (every one optional; these are the defaults)
# ---------------------------------------------------------------------------
# AGENT_TERMINAL_PROJECTS_ROOT=~/vs-code      the folders offered first, and watched for PRs
# AGENT_TERMINAL_DATA_DIR=%LOCALAPPDATA%\AgentTerminal      saved tabs and the app log
# AGENT_TERMINAL_SHELL=pwsh
# AGENT_TERMINAL_CLAUDE_COMMAND=claude
# AGENT_TERMINAL_CODEX_COMMAND=codex
# AGENT_TERMINAL_GH_COMMAND=gh
# AGENT_TERMINAL_PR_POLL_SECONDS=60           seconds between asking GitHub about each repo
# AGENT_TERMINAL_CLAUDE_HOME=~/.claude        CLAUDE_CONFIG_DIR is honoured first
# AGENT_TERMINAL_CLAUDE_CONFIG_FILE=~/.claude.json      read for trust; CLAUDE_CONFIG_DIR first
# AGENT_TERMINAL_CODEX_HOME=~/.codex          CODEX_HOME is honoured first

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Resource attributes. `service.instance.id` is what distinguishes two worktrees
# exporting to the same collector — without it their metrics silently merge.
OTEL_SERVICE_NAME=agent-terminal
OTEL_RESOURCE_ATTRIBUTES=service.name=agent-terminal,service.instance.id=agent-terminal,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
